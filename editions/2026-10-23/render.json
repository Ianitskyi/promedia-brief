  "duration_sec": 147.93,
  "asr": {
    "model": "faster-whisper-small",
    "threshold": 0.2,
    "mean_cer": 0.031,
    "failed": [],
    "segments": [
      {
        "id": "intro",
        "cer": 0.043,
        "transcript": "це брів добірка новин з перевірених медіа яким можна довіряти повний список джерел доступний на сайті брів випуск за двадцять третього жовтня"
      },
      {
        "id": "national-heading",
        "cer": 0.0,
        "transcript": "новини україни"
      },
      {
        "id": "national-c-741d5956e4d495fd",
        "cer": 0.098,
        "transcript": "у нас лікросійської атаки на дніпро загинула людина щоб п'ятеро отримали поранення"
      },
      {
        "id": "national-c-3485be52552ab933",
        "cer": 0.069,
        "transcript": "двадцять третього жовтня ер еф атакувала полтавську громаду бпл а повідомляю в полтаві за попередньою інформацією загиблих та травмованих немає"
      },
      {
        "id": "national-c-40c378f897130df1",
        "cer": 0.06,
        "transcript": "у лікарні померла жінка пора не навнасліду кудару росіян по ринку в лозовій на харківщині якого вони завдалив четвер"
      },
      {
        "id": "national-c-3be046e7e9b73552",
        "cer": 0.027,
        "transcript": "німеччина веде з україною перемовини про закупівлю українських ракет якими били по москві повідомляє громецьке"
      },
      {
        "id": "national-c-3d6e72a2ae448981",
        "cer": 0.0,
        "transcript": "двадцять третього жовтня у харківській області застосовуватимуть графіки погодинних відключень електроенергії з шість нуль до двадцять три п'ятдесят дев'ять повідомили в обленерго"
      },
      {
        "id": "national-c-1892fbea98b3267e",
        "cer": 0.024,
        "transcript": "президент володимир зеленський повідомив що три сторонню зустріч на рівні команд що до завершення війни ер еф проти україни планують провести у першій половині еластопада"
      },
      {
        "id": "national-c-82f7ad6679158d45",
        "cer": 0.004,
