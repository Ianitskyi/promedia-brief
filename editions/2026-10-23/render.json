  "duration_sec": 180.3,
  "asr": {
    "model": "faster-whisper-small",
    "threshold": 0.2,
    "mean_cer": 0.03,
    "failed": [],
    "segments": [
      {
        "id": "intro",
        "cer": 0.043,
        "transcript": "це брів добірка новин з перевірених медіа яким можна довіряти повний список джерел доступний на сайті брів випуск за двадцять третього жовтня"
      },
      {
        "id": "national-heading",
        "cer": 0.0,
        "transcript": "новини україни"
      },
      {
        "id": "national-c-122f5115f9474efa",
        "cer": 0.039,
        "transcript": "кількість поранених у нас ли до кудару російської армії по центральному ринку в лозовій харківської області зросла до тридцять шість осіб двоє людей загинули"
      },
      {
        "id": "national-c-5c14290798137aba",
        "cer": 0.0,
        "transcript": "протягом двадцять другого жовтня на фронті сталося сто сорок шість бойових зіткнень сил оборони україни з російськими загарбниками"
      },
      {
        "id": "national-c-16e1cec21e106c65",
        "cer": 0.026,
        "transcript": "у наслідок атаки реактивних дронів на волинь зранку двадцять третього жовтня частина жителів в області залишилися без електропостачання станув на ранок без світла майже сто п'ять тисяч абонентів"
      },
      {
        "id": "national-c-136a2455402bbd63",
        "cer": 0.022,
