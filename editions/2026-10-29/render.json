  "asr": {
    "model": "faster-whisper-small",
    "threshold": 0.2,
    "mean_cer": 0.03,
    "failed": [],
    "segments": [
      {
        "id": "intro",
        "cer": 0.036,
        "transcript": "це брів добірка новин з перевірених медіа яким можна довіряти повний список джерел доступний на сайті брів випуск за двадцять дев'ятого жовтня"
      },
      {
        "id": "national-heading",
        "cer": 0.0,
        "transcript": "новини україни"
      },
      {
        "id": "national-c-08b2146ad3d39a5a",
        "cer": 0.036,
        "transcript": "російські війська завдали удару реактивним безпілотником по залізничному вокзалу в дніпрі повідомляє щотири удар припав на одну з платформ де в цей час перебував поїздено вісімсот шістдесят шість з полученням дніпро запоріжджя"
      },
      {
        "id": "national-c-065b60d8417de820",
        "cer": 0.051,
        "transcript": "аварія сталася вранці двадцять восьмого жовтня в центральному регіоні кастилія ламанча на залізничній лінії що з'єднує мадриди з південним регіоном андалусі поїзд оператора рнф врізався в хвостову частину іншого поїзда перевізника іріо який у той момент стояв на колі"
      },
      {
        "id": "national-c-0b945d1ee332aed5",
        "cer": 0.053,
        "transcript": "двадцять дев'ятого жовтня в день у кримінчуці ворожий бпла влучив у багатоквартирний житловий будинок повідомляє у полтаві в наслідок атаки двоє людей загинули дев'ятеро отримали травми"
      },
      {
        "id": "national-c-02ff28e930d67c46",
        "cer": 0.013,
        "transcript": "двадцять восьмого жовтня російські війська обстріляли слов'янськ з різних видів озброєння загинув чоловік тисяча дев'ятсот шістдесят сьомого року народження пошкоджені приватні та багатоповерхові будинки магазин автівки і підприємства"
      },
      {
        "id": "national-c-01896128678a7904",
        "cer": 0.047,
        "transcript": "українська делегація начолі зомбудсменом дмитром лубінцем двадцять дев'ятого жовтня виїхала в напрямку олешок на херсонщині для гуманітарної місії повідомляй район інва"
      },
      {
        "id": "national-c-2e8cf45a9cbf555e",
        "cer": 0.022,
