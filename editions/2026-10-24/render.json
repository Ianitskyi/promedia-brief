  "asr": {
    "model": "faster-whisper-small",
    "threshold": 0.2,
    "mean_cer": 0.03,
    "failed": [],
    "segments": [
      {
        "id": "intro",
        "cer": 0.035,
        "transcript": "це брів добірка новин з перевірених медіа яким можна довіряти повний список джерел доступний на сайті брів випуск за двадцять четвертого жовтня"
      },
      {
        "id": "national-heading",
        "cer": 0.0,
        "transcript": "новини україни"
      },
      {
        "id": "national-c-1e21b748fe94b479",
        "cer": 0.013,
        "transcript": "двадцять третього жовтня російські війська атакували краматорський слов'янськ в наслідок ворожих обстрілів та ударів дронами поранень зазнали дев'ятеро людей пошкоджено житлові будинки автівки магазин та знищено двадцять автобусів"
      },
      {
        "id": "national-c-36a4f9a44fb5fe60",
        "cer": 0.006,
        "transcript": "у частині голосівського та соломянського районів києва та чотирьох районах київської області у суботу вранці застосовані екстрені відключення електроенергії"
      },
      {
        "id": "national-c-0700612edc45dd09",
        "cer": 0.03,
        "transcript": "російські війська за добу атакували обласний центр і ще п'ятнадцять населених пунктів харківської області в наслідок обстрілів постраждали сім людей зокрема двоє дітей"
      },
      {
        "id": "national-c-0c3819112a60791f",
        "cer": 0.016,
        "transcript": "іран розробив плана так на підводній кабелі зв'язку у перській затоці на випадок нових ударів з боку сполучені штати та ізраїлю тегеран також розглядає можливість перешкоджати ремонту пошкодженої інфраструктури щоб якомога довше зберігати перебої зі зв'язком"
      },
      {
        "id": "national-c-0df00463818e36c3",
        "cer": 0.02,
        "transcript": "у повноважений верховної ради справ людини дмитро лубіниць поінформував що припинення вогню між україною та росією заплановане на двадцять сьомого жовтня діятиме не лише в заблокованих олежках а й на території всієї херсонської області та суміжних регіонів через які проходятимуть гуманітарні маршрути"
      },
      {
        "id": "national-c-741d5956e4d495fd",
        "cer": 0.085,
        "transcript": "у нас лікросійської атаки на дніпро загинула людина що п'ятеро отримали поранення"
      },
      {
        "id": "national-c-29f4a5a24eed20ea",
        "cer": 0.009,
        "transcript": "державний секретар сполучені штати марко рубіо заявив що війна росії проти україни стосується перед усім донбасу який влада рев прагне захопити проте не може встановити над ним контроль військовим шляхом водночас україна не погоджується віддавати цю територію маючи вагомі причини пов'язані із суверенітетом і власною довгостроковою безпекою"
