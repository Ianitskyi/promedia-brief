  "duration_sec": 165.56,
  "asr": {
    "model": "faster-whisper-small",
    "threshold": 0.2,
    "mean_cer": 0.028,
    "failed": [],
    "segments": [
      {
        "id": "intro",
        "cer": 0.038,
        "transcript": "це брів добірка новин з перевірених медіа яким можна довіряти повний список джерел доступний на сайті брів випуск за тридцятого жовтня"
      },
      {
        "id": "national-heading",
        "cer": 0.0,
        "transcript": "новини україни"
      },
      {
        "id": "national-c-0775b9548daccc55",
        "cer": 0.005,
        "transcript": "кількість загиблих у наслідок російської атаки на залізничний вокзал у дніпрі тридцятого жовтня зросла до п'ятнадцять людей шість постраждалих перебувають у важкому стані зокрема дитина"
      },
      {
        "id": "national-c-046741c892c836d9",
        "cer": 0.0,
        "transcript": "у києві внаслідок атаки російських військ в ніч на тридцятого жовтня загинула людина"
      },
      {
        "id": "national-c-43aee72686c3403b",
        "cer": 0.02,
        "transcript": "у ночі та вранці тридцятого жовтня російські війська завдали ударів по кількох регіонах україни у києві внаслідок російської атаки загинула людина у дні припост рождали двоє підлітків а через пошкодження енергетичної інфраструктури понад триста п'ятдесят тисяч абонентів залишилися без електропостачання"
      },
      {
        "id": "national-c-4448e4ba239b2cde",
        "cer": 0.008,
        "transcript": "упродовж доби окупанти завдали сімсот дев'яносто два удари по п'ятдесят шість населених пунктах запоріської області двоє людей загинули ще двадцять три серед яких неповнолітній отримали поранення внаслідок ворожих атак по обласному центру та запоріському району"
      },
      {
        "id": "national-c-0eaa365c2a3f6d92",
        "cer": 0.021,
        "transcript": "українська делегація прибула в окупованні олежки на херсонщині для проведення гуманітарної місії"
      },
      {
        "id": "national-c-03e76b1e79c45078",
        "cer": 0.007,
