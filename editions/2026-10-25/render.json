  "asr": {
    "model": "faster-whisper-small",
    "threshold": 0.2,
    "mean_cer": 0.04,
    "failed": [],
    "segments": [
      {
        "id": "intro",
        "cer": 0.036,
        "transcript": "це брів добірка новин з перевірених медіа яким можна довіряти повний список джерел доступний на сайті брів випуск за двадцять п'ятого жовтня"
      },
      {
        "id": "national-heading",
        "cer": 0.0,
        "transcript": "новини україни"
      },
      {
        "id": "national-c-00ed769a0be94601",
        "cer": 0.005,
        "transcript": "президент володимир зеленський заявив що за цей тиждень росія випустила по україні близько тисяча шістсот кированих авіабомб сорок вісім ракет різних типів зокрема балістичних та майже дві тисячі триста ударних дронів"
      },
      {
        "id": "national-c-3b570bd798758282",
        "cer": 0.043,
        "transcript": "сьогодні двадцять п'ятого жовтня від тяжких поранень після російського обстрілу у лікарні помер начальник караулу гуде снс запоріської області юрій ільченко"
      },
      {
        "id": "national-c-08d0372cc2f942ed",
        "cer": 0.06,
        "transcript": "автомобіль тоюота та мотоцикл гонда зіткнулися на ерокосмічному проспекті у харкові у вечірі двадцять четвертого жовтня тридцятишестирічний кермовальник легковика виїхав на зустрічну смугу внаслідок аварії сорокачотирирічний мотоцикліст помер у швидкій"
      },
      {
        "id": "national-c-09c909f787b39cf3",
        "cer": 0.0,
        "transcript": "у донецькій області минулої доби внаслідок російських обстрілів загинула одна людина шестеро зазнали поранень"
      },
      {
        "id": "national-c-11bfac9614a074cf",
        "cer": 0.008,
        "transcript": "медики госпіталізували двох людей із села сівка калузька івано франківської області з попереднім діагнозом отруєння чадним газом"
      },
      {
        "id": "national-c-0e77129478c2cfb7",
        "cer": 0.057,
        "transcript": "в день у неділю двадцять п'ятого жовтня росіяни поцілили биспілотником у маршрутне таксі у центральному районі херсона у нас і до катаки загинув чоловік що п'ять людей постраждали"
      },
      {
        "id": "national-c-5cfd26189819215f",
        "cer": 0.177,
        "transcript": "у частині областей україни з шість цілих нуль десятих до двадцять три цілих п'ятдесят дев'ять сотих понеділка двадцять шостого жовтня буде обмежене споживання електроенергії"
