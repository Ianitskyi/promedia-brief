  "asr": {
    "model": "faster-whisper-small",
    "threshold": 0.2,
    "mean_cer": 0.03,
    "failed": [],
    "segments": [
      {
        "id": "intro",
        "cer": 0.036,
        "transcript": "це брів добірка новин з перевірених медіа яким можна довіряти повний список джерел доступний на сайті брів випуск за двадцять п'ятого жовтня"
      },
      {
        "id": "national-heading",
        "cer": 0.0,
        "transcript": "новини україни"
      },
      {
        "id": "national-c-09c909f787b39cf3",
        "cer": 0.0,
        "transcript": "у донецькій області минулої доби внаслідок російських обстрілів загинула одна людина шестеро зазнали поранень"
      },
      {
        "id": "national-c-01e646bcbec967e9",
        "cer": 0.056,
        "transcript": "трої людей загинули що найменше восьмер одістали поранень внаси до кудару російськими військами по місту синельникове дніпропетровської області"
      },
      {
        "id": "national-c-0cfa49fc1b2e2273",
        "cer": 0.027,
        "transcript": "близького півночі двадцять четвертого жовтня росіяни вдарили реактивним безпілотником по новобаварському району харкова повідомив міський голова ігор терехов що не менше одна людина загинула що четверо за його даними постраждали"
      },
      {
        "id": "national-c-0e8defc5ba385624",
        "cer": 0.017,
        "transcript": "у ранці двадцять п'ятого жовтня російські війська атакували харків і вінницю у харкові постраждали четверо людей зокрема троє рятувальників де ес ен ес а у вінниців наслідок влучання беспілотника в п'ятиповерхівку травмувалися шестеро людей"
      },
      {
        "id": "national-c-0252ca1a0d69fd1d",
        "cer": 0.015,
        "transcript": "у києві через аварію у частинах голосівського шевченківського і солом'янського районів вели аварійні відключення світла через аварію"
      },
      {
        "id": "national-c-4a3bf64a5e71ba54",
        "cer": 0.011,
        "transcript": "лише за цей тиждень росія випустила по україні близько тисяча шістсот кированих авіабом сорок вісім ракет різних типів зокрема балістичних та майже дві тисячі триста ударних дронів"
      },
      {
        "id": "national-c-3d26ef9f048bdde4",
        "cer": 0.017,
