  "duration_sec": 167.39,
  "asr": {
    "model": "faster-whisper-small",
    "threshold": 0.2,
    "mean_cer": 0.042,
    "failed": [],
    "segments": [
      {
        "id": "intro",
        "cer": 0.036,
        "transcript": "це брів добірка новин з перевірених медіа яким можна довіряти повний список джерел доступний на сайті брів випуск за двадцять другого жовтня"
      },
      {
        "id": "national-heading",
        "cer": 0.0,
        "transcript": "новини україни"
      },
      {
        "id": "national-c-03465567cc0ff382",
        "cer": 0.039,
        "transcript": "кількість поранених у нас ли до кудару російської армії по центральному ринку в лозовій харківської області зросла до тридцять шість осіб двоє людей загинули"
      },
      {
        "id": "national-c-2fa36d044221affd",
        "cer": 0.03,
        "transcript": "у вечері двадцять другого жовтня російські війська завдали ударів по запоріжджі та житомирській громаді в наслідок ворожих атаку запоріжджі загинули двоє людей а в житомирській громаді що найменше дев'ять мирних мешканців дістали поранення"
      },
      {
        "id": "national-c-03a04248094339fe",
        "cer": 0.014,
        "transcript": "україна та фінляндія підписали сім документів про співпрацю на загальну суму триста мільйонів євро домовленості передбачають новий пакет підтримки для україни розширення використання фінських супутникових технологій а також допомого взміцнення логістики і енергетичної інфраструктури"
      },
      {
        "id": "national-c-15095a7a30ae0d86",
        "cer": 0.177,
        "transcript": "у частині областей україни з шість цілих нуль десятих до двадцять три цілих п'ятдесят дев'ять сотих п'ятниці двадцять третього жовтня буде обмежене споживання електроенергії"
      },
      {
        "id": "national-c-0fd00518a5945c4b",
        "cer": 0.05,
        "transcript": "у києві внаслідок нічної та вичернює російських атак загинула одна людина ще двадцять чотири постраждали середних діти"
      },
      {
        "id": "national-c-21897e9a0a2e7322",
        "cer": 0.044,
