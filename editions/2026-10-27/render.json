  "duration_sec": 155.79,
  "asr": {
    "model": "faster-whisper-small",
    "threshold": 0.2,
    "mean_cer": 0.031,
    "failed": [],
    "segments": [
      {
        "id": "intro",
        "cer": 0.036,
        "transcript": "це брів добірка новин з перевірених медіа яким можна довіряти повний список джерел доступний на сайті брів випуск за двадцять сьомого жовтня"
      },
      {
        "id": "national-heading",
        "cer": 0.0,
        "transcript": "новини україни"
      },
      {
        "id": "national-c-3194ef3422ddea10",
        "cer": 0.008,
        "transcript": "у києві фахівці оцінюють ступінь пошкоджень на південному мосту після російського балістичного удару в ночі двадцять сьомого жовтня"
      },
      {
        "id": "national-c-0b00264b290a02e1",
        "cer": 0.03,
        "transcript": "у наслідок російського обстрілу новобаварського району харкова двадцять шостого жовтня загинули двоє людей ще четверо постраждали повідомляє район інва пошкоджені будинки автомобілі та дитячий заклад"
      },
      {
        "id": "national-c-a9d5357020ee5322",
        "cer": 0.018,
        "transcript": "ворох знову спробував атакувати чернівецьку область вночі"
      },
      {
        "id": "national-c-0c086ab8c7db1d6f",
        "cer": 0.026,
        "transcript": "в умені на понад дев'яносто відсотків відновили багатоповерхівку яку у дві тисячі двадцять третьому році зруйнувала російська ракета тоді загинули двадцять чотири людини з них шість дітей"
      },
      {
        "id": "national-c-0db5da66155d69cd",
        "cer": 0.032,
