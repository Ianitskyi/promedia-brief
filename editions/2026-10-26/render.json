  "duration_sec": 185.03,
  "asr": {
    "model": "faster-whisper-small",
    "threshold": 0.2,
    "mean_cer": 0.025,
    "failed": [],
    "segments": [
      {
        "id": "intro",
        "cer": 0.036,
        "transcript": "це брів добірка новин з перевірених медіа яким можна довіряти повний список джерел доступний на сайті брів випуск за двадцять шостого жовтня"
      },
      {
        "id": "national-heading",
        "cer": 0.0,
        "transcript": "новини україни"
      },
      {
        "id": "national-c-10dcd3653be583b8",
        "cer": 0.0,
        "transcript": "лікарі п'ять днів боролися за її життя"
      },
      {
        "id": "national-c-285b1a517b37d75e",
        "cer": 0.006,
        "transcript": "на херсонщині упродовж минулої доби через російські обстріли загинула людина восьмеропоранених війська ер еф атакували тридцять один населений пункт області"
      },
      {
        "id": "national-c-68e78e86426efc1c",
        "cer": 0.026,
        "transcript": "вночі двадцять шостого жовтня безпілотники атакували російський воронеж де спалахнули пожежі на кількох промислових підприємствах під ударом опинилися завод воронеж синтиска учук та авіазавод васу"
      },
      {
        "id": "national-c-02264349cfe5ee35",
        "cer": 0.028,
        "transcript": "у повноважений верховної ради з питань захисту прав людини дмитро лубінець закликав надати його офісу будь яку інформацію яка може допомогти в організації гуманітарної місії в окупованні олежки херсонської області відповідний дописом буцсману прилюднив у неділю двадцять п'ятого жовтня"
      },
      {
        "id": "national-c-0df81ac36b1033ba",
        "cer": 0.015,
