  "duration_sec": 162.43,
  "asr": {
    "model": "faster-whisper-small",
    "threshold": 0.2,
    "mean_cer": 0.029,
    "failed": [],
    "segments": [
      {
        "id": "intro",
        "cer": 0.036,
        "transcript": "це брів добірка новин з перевірених медіа яким можна довіряти повний список джерел доступний на сайті брів випуск за двадцять шостого жовтня"
      },
      {
        "id": "national-heading",
        "cer": 0.0,
        "transcript": "новини україни"
      },
      {
        "id": "national-c-0b00264b290a02e1",
        "cer": 0.03,
        "transcript": "у наслідок російського обстрілу новобаварського району харкова двадцять шостого жовтня загинули двоє людей ще четверо постраждали повідомляє район інвуа пошкоджені будинки автомобілі та дитячий заклад"
      },
      {
        "id": "national-c-0eccc3fee86f64be",
        "cer": 0.017,
        "transcript": "сьогодні двадцять шостого жовтня російські загарбники атакували безпілотником павло град дніпропетровської області внаслідок чого одна людина загинула також серед поранених їдіти"
      },
      {
